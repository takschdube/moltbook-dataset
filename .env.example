# Moltbook API Configuration
MOLTBOOK_API_KEY=your_api_key_here
MOLTBOOK_BASE_URL=https://www.moltbook.com/api/v1

# Crawl Configuration
REQUEST_DELAY=0.5
MAX_RETRIES=3
COMMENT_WORKERS=10
CHECKPOINT_INTERVAL=100
HOT_PAGES=20  # Pages to scan per sort order (hot, rising) — 20 pages = 1000 posts each

# Output Configuration
DATA_DIR=data
ARCHIVE_DIR=archives

# Hugging Face (for auto-upload)
HF_TOKEN=
HF_REPO=your_username/moltbook-dataset

# Kaggle (for auto-upload)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Zenodo (for DOI and academic citations)
ZENODO_TOKEN=
# ZENODO_DEPOSITION_ID=  # Set after first upload for versioning
# ZENODO_AUTO_PUBLISH=false  # Set to 'true' to auto-publish
